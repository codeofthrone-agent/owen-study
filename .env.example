# SwitchBot 配置
TOKEN=your_switchbot_token_here
SECRET=your_switchbot_secret_here
DEVICE_ID=your_device_id_here

# IP Camera RTSP 認證（所有攝影機共用）
# 若個別攝影機需要不同帳密，請在 config/ipcam_config.yaml 中單獨設定
IPCAM_USERNAME=admin
IPCAM_PASSWORD=your_password_here

# 多模態檢測 UART Port
# 用於語音助理等測試，設定監聽的串列埠
UART_PORT=/dev/ttyUSB0

# TestLink 整合配置
# TestLink API URL（通常格式為：http://your-testlink-server/testlink/lib/api/xmlrpc/v1/xmlrpc.php）
TESTLINK_API_URL=http://localhost/testlink/lib/api/xmlrpc/v1/xmlrpc.php
# TestLink API Key（從 TestLink 個人設定中取得）
TESTLINK_API_KEY=your_testlink_api_key_here
# TestLink 專案名稱（選填，預設值：Robot Automation Project）
TESTLINK_PROJECT_NAME=Robot Automation Project
# TestLink 測試計畫名稱（選填，預設值：Automated Test Plan）
TESTLINK_TEST_PLAN_NAME=Automated Test Plan
# TestLink Build 名稱（選填，預設值：Build 1.0）
TESTLINK_BUILD_NAME=Build 1.0
